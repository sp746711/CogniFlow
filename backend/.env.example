# ==============================================================
# CogniFlow Backend Environment Template
# ==============================================================

# Application Settings
APP_NAME=CogniFlow
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# API Server Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_PREFIX=/api

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cogniflow

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
